      "updated": 1784790718808,
      "link": null,
      "locked": false,
      "text": "Why caching",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Why caching",
      "autoResize": true,
