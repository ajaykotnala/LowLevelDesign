    {
      "id": "MlI4h2ynaieQ7fEV1RDnH",
      "type": "text",
      "x": -6515.95042022908,
      "y": 15605.0003264484,
      "width": 772.5596923828125,
      "height": 360,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c0DH",
      "roundness": null,
      "seed": 1340150393,
      "version": 593,
      "versionNonce": 1113573209,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784790718808,
      "link": null,
      "locked": false,
      "text": "Back of envelope estimation\n- 100m * 100 = 1B swipes per day\n- 1B /(24*60*60) 86k = 12k per sec\n- 10k swipes * 10(times) = 100k swipes per sec\n- 100 byte * 100kb peak per sec\n\n\n",
      "fontSize": 36,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Back of envelope estimation\n- 100m * 100 = 1B swipes per day\n- 1B /(24*60*60) 86k = 12k per sec\n- 10k swipes * 10(times) = 100k swipes per sec\n- 100 byte * 100kb peak per sec\n\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
