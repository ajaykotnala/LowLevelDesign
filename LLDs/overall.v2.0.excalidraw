      "versionNonce": 1433687385,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784790718808,
      "link": null,
      "locked": false,
      "text": "- by default kafka batches the message but you can also use sendBatch method as well",
      "fontSize": 28,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- by default kafka batches the message but you can also use sendBatch method as well",
      "autoResize": true,
