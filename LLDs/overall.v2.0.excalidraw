    {
      "id": "hTQHKYAvPKwqajoLa_20b",
      "type": "text",
      "x": -9879.62014900774,
      "y": 30466.770329903396,
      "width": 409.9477233886719,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c0KE",
      "roundness": null,
      "seed": 2100299673,
      "version": 85,
      "versionNonce": 1197048983,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784790718808,
      "link": null,
      "locked": false,
      "text": "\nHow to scale?\n\n1) Choose partition key carefully\n2) More broker",
      "fontSize": 28,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\nHow to scale?\n\n1) Choose partition key carefully\n2) More broker",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "-G9hlYwZhaL11C9QWH8Wc",
      "type": "text",
      "x": -9879.62014900774,
      "y": 30706.770329903396,
      "width": 1290.7708740234375,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c0KF",
      "roundness": null,
      "seed": 148745337,
      "version": 325,
      "versionNonce": 408941657,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784790718808,
      "link": null,
      "locked": false,
      "text": "Choose partition key carefully so that hot key issue can be resolved.\n\n1) Remove the key so that kafka can do it on your own- specially if you do not need order the message\n2) choose compound key\n3) back pressure - let producer know i am getting overwealm - slow down the producer",
      "fontSize": 28,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Choose partition key carefully so that hot key issue can be resolved.\n\n1) Remove the key so that kafka can do it on your own- specially if you do not need order the message\n2) choose compound key\n3) back pressure - let producer know i am getting overwealm - slow down the producer",
      "autoResize": true,
      "lineHeight": 1.25
    },
