      "boundElements": [],
      "updated": 1784790718808,
      "link": null,
      "locked": false,
      "text": "const producer = kafka.producer({\n  retry: {\n    retries: 5, // Retry up to 5 times\n    initialRetryTime: 100, // Wait 100ms between retries\n  },\n  idempotent: true,\n});",
      "fontSize": 28,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "const producer = kafka.producer({\n  retry: {\n    retries: 5, // Retry up to 5 times\n    initialRetryTime: 100, // Wait 100ms between retries\n  },\n  idempotent: true,\n});",
      "autoResize": true,
      "lineHeight": 1.25
    },
