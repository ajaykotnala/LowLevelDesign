      "isDeleted": false,
      "boundElements": [],
      "updated": 1784790718808,
      "link": null,
      "locked": false,
      "text": "const { CompressionTypes } = require('kafkajs')\n\nawait producer.send({\n      topic: 'my_topic',\n      compression: CompressionTypes.GZIP,\n      messages: [\n        { key: 'key1', value: 'Hello, Kafka!' },\n      ],\n    });",
      "fontSize": 28,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "const { CompressionTypes } = require('kafkajs')\n\nawait producer.send({\n      topic: 'my_topic',\n      compression: CompressionTypes.GZIP,\n      messages: [\n        { key: 'key1', value: 'Hello, Kafka!' },\n      ],\n    });",
      "autoResize": true,
      "lineHeight": 1.25
