      "link": null,
      "locked": false,
      "text": "avg RPS = 10B(10 000 000 000) divided by 1day in sec (24*60*60)",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "avg RPS = 10B(10 000 000 000) divided by 1day in sec (24*60*60)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "uLHmKMo_aJWYGNPPbWwKY",
      "type": "text",
      "x": -7795.745452891621,
      "y": 3628.1620750650127,
      "width": 693,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
