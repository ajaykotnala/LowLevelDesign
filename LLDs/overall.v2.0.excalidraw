    },
    {
      "type": "text",
      "version": 1381,
      "versionNonce": 1530746393,
      "index": "c02l",
      "isDeleted": false,
      "id": "ou2JLilbt1tlRDtNBUR2X",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": -7769.076254466831,
      "y": 2257.530385794722,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "width": 415.79974365234375,
      "height": 45,
      "seed": 72740857,
      "groupIds": [],
