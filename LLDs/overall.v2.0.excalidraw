      "link": null,
      "locked": false,
      "text": "Tinder is mobile dating app that helps people connect by allowing users \nto swipe right to like or left to pass on profiles.\nIt uses location data and user specific filters/ preferences to suggest potential matches nearby.",
      "fontSize": 46.66666666666665,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Tinder is mobile dating app that helps people connect by allowing users \nto swipe right to like or left to pass on profiles.\nIt uses location data and user specific filters/ preferences to suggest potential matches nearby.",
      "autoResize": true,
      "lineHeight": 1.25
