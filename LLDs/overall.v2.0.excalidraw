    },
    {
      "id": "o8EIgFVrUIuakMLLQLZn6",
      "type": "text",
      "x": -7647.423636410919,
      "y": 5182.193785013201,
      "width": 698.3237740928384,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
