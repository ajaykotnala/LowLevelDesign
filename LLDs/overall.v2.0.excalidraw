    },
    {
      "id": "dbk9pPKuSZ-nlV2hfOTzd",
      "type": "text",
      "x": -7649.4915312225485,
      "y": 5340.197767497417,
      "width": 698.3237740928384,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c018",
      "roundness": null,
      "seed": 863288217,
      "version": 890,
      "versionNonce": 292883095,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784790718808,
      "link": null,
      "locked": false,
      "text": "Accessing data from a disk-backed database — even a fast SSD —\ntakes roughly 1 millisecond. Accessing the same data from RAM\ntakes about 100 nanoseconds. That's approximately 10,000 times\nfaster.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Accessing data from a disk-backed database — even a fast SSD — takes roughly 1 millisecond. Accessing the same data from RAM takes about 100 nanoseconds. That's approximately 10,000 times faster.",
      "autoResize": false,
      "lineHeight": 1.25
    },
