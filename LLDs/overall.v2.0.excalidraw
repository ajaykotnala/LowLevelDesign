      "updated": 1784790718808,
      "link": null,
      "locked": false,
      "text": "As kafka commits the recent offset you can always read it back and once consumer spins up it can take it over\n",
      "fontSize": 28,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "As kafka commits the recent offset you can always read it back and once consumer spins up it can take it over\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
