      "isDeleted": false,
      "boundElements": [],
      "updated": 1784790718808,
      "link": null,
      "locked": false,
      "text": "Issue 2: Events are not processed in correct order?\nSolution: separate out the queue (partition)",
      "fontSize": 32.98697916666716,
