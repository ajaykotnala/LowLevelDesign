    {
      "id": "67XSWGQPZhWLbXgeZna_-",
      "type": "text",
      "x": -9479.62014900774,
      "y": 21338.10366323675,
      "width": 1165.561241912842,
      "height": 45.42187500000002,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
