    },
    {
      "id": "-vTwxoEr4vfMhnAmcCAyv",
      "type": "text",
      "x": -9498.2868156744,
      "y": 35248.77032990342,
      "width": 1105.38330078125,
      "height": 35,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
