    },
    {
      "id": "WqFrxlK9uSNSThMhk2BYR",
      "type": "text",
      "x": -9805.0290031744,
      "y": 35918.73126740342,
      "width": 587.8035278320312,
      "height": 315,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
