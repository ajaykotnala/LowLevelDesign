      "boundElements": [],
      "updated": 1784790718808,
      "link": null,
      "locked": false,
      "text": "kafka-console-consumer --bootstrap-server localhost:9092 --topic my_topic --from-beginning --property print.key=true --property key.separator=\": \"\n\n# Output\nkey1: Hello, Kafka with key!\nkey2: Another message with a different key",
