      "boundElements": [],
      "updated": 1784790718808,
      "link": null,
      "locked": false,
      "text": "Issue 1: events spemtede -- too many events comes to queue and consumer is getting overwhelm\nSolution: scale queue horizantal ",
      "fontSize": 35.57291666666717,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Issue 1: events spemtede -- too many events comes to queue and consumer is getting overwhelm\nSolution: scale queue horizantal ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "pIayOqaxsZOHal6wCnicH",
      "type": "text",
      "x": -9728.875357341065,
      "y": 17586.603663236732,
