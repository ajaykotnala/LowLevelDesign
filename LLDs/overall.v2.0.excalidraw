      "versionNonce": 2047335959,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784790718808,
      "link": null,
      "locked": false,
      "text": "= (10 000 000 000) / 86,400 =  115k req/sec\n\nPeak RPS = avg RPS * 5(peak traffic multiplier) = 580K req/sec ",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "= (10 000 000 000) / 86,400 =  115k req/sec\n\nPeak RPS = avg RPS * 5(peak traffic multiplier) = 580K req/sec ",
      "autoResize": true,
      "lineHeight": 1.25
    },
