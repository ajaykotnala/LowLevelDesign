      "isDeleted": false,
      "boundElements": [],
      "updated": 1785410440180,
      "link": null,
      "locked": false,
      "text": "Consistency for matching\n\n- we dont send more than one request at a time for given ride.\n- we dont send any driver more than one request \n\n\nwhile(noMatch)\n{\ndriver = nextDriver\nlock(driver)\nsendNotifiucation\nwait(10sec)\n}",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Consistency for matching\n\n- we dont send more than one request at a time for given ride.\n- we dont send any driver more than one request \n\n\nwhile(noMatch)\n{\ndriver = nextDriver\nlock(driver)\nsendNotifiucation\nwait(10sec)\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
