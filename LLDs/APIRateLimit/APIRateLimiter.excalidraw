      "isDeleted": false,
      "boundElements": [],
      "updated": 1755278389443,
      "link": null,
      "locked": false,
      "text": "Functional Requirements\n- identify users by id, IP, or api key\n- limit requests based on configurable rules \n- return proper error headers and status codes ",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional Requirements\n- identify users by id, IP, or api key\n- limit requests based on configurable rules \n- return proper error headers and status codes ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "gQ8cc9TSMjBpGavnVDqNk",
      "type": "text",
      "x": 588.6797589732919,
      "y": 599.7184863087109,
      "width": 443.6666666666663,
      "height": 151.24999999999997,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ab",
      "roundness": null,
      "seed": 1419220988,
      "version": 496,
      "versionNonce": 1444856046,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1779962436950,
      "link": null,
      "locked": false,
      "text": "\n\nNon-functional Requirements\n- availability >> consistency\n- low latency rate limit checks (< 10ms)\n- scalable to 1M rps",
      "fontSize": 20.16666666666666,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\n\nNon-functional Requirements\n- availability >> consistency\n- low latency rate limit checks (< 10ms)\n- scalable to 1M rps",
