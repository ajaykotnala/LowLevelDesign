    {
      "id": "xx-apoBIujLj2CJ3KNjwL",
      "type": "text",
      "x": -238.24747110649417,
      "y": 1619.0092482729415,
      "width": 539,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
