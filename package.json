{
  "name": "lld-design-patterns",
  "version": "0.1.0",
  "private": true,
  "author": "Ajay kotnale",
  "license": "MIT",
  "description": "Design Patterns in TypeScript",
  "keywords": [
    "design-patterns",
    "typescript",
    "javascript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ajaykotnale/lld-design-patterns"
  },
  "bugs": {
    "url": "https://github.com/ajaykotnale/lld-design-patterns/issues"
  },
  "homepage": "https://github.com/ajaykotnale/lld-design-patterns#readme",
  "engines": {
    "node": ">=14.0.0"
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "packageManager": "npm@8.19.2",
  "scripts": {
    "build": "tsc",
    "run": "npm run basicfactory",
    "singleton": "npm run build && node dist/creational/singleton.pattern.js",
    "basicfactory": "npm run build && node dist/creational/basic-factory-pattern.js",
    "advancefactory": "npm run build && node dist/creational/advace-factory-pattern.js",
    "abstractfactory": "npm run build && node dist/creational/abstract.factory.js",
    "builder": "npm run build && node dist/creational/builder-pattern.js",
    "prototype": "npm run build && node dist/creational/prototype-pattern.js",
    "decorator": "npm run build && node dist/structural/decorator.js",
    "coffeedecorator": "npm run build && node dist/structural/coffee.decorator.js",
    "adaptor": "npm run build && node dist/structural/adaptor.js",
    "composite": "npm run build && node dist/structural/composite.js",
    "facade": "npm run build && node dist/structural/facade.js",
    "proxy": "npm run build && node dist/structural/proxy.js"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
